# SupportAI — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com os valores do seu projeto Firebase.
# NUNCA commit o .env.local no repositório.

# Firebase Web App Config (público — segurança real está nas Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Ambiente (development | production)
NEXT_PUBLIC_APP_ENV=development

# Emuladores (usado apenas em development)
# Deixe como "true" para conectar ao Firebase Emulator Suite localmente
NEXT_PUBLIC_USE_EMULATORS=true
